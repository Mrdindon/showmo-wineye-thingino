+	await requireLogin();
+	document.getElementById("live").src = "/x/ch0.mjpg";
+	const st = await getJSON("status");
+	document.getElementById("name").textContent = st.device.hostname;
+	document.getElementById("rtsp").textContent = rtspUrl(st, true);
+	document.getElementById("copy").onclick = () =>
+		navigator.clipboard.writeText(rtspUrl(st)).then(() => toast("URL copiée (sans le mot de passe)"));
+})();
+</script>
+</body>
+</html>
diff --git a/configs/cameras-exp/showmo_prj007_t32nq_gc8602_aic8800d80/overlay/var/www/login.html b/configs/cameras-exp/showmo_prj007_t32nq_gc8602_aic8800d80/overlay/var/www/login.html
