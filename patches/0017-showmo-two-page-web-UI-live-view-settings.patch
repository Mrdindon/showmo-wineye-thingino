--- /dev/null
+++ b/configs/cameras-exp/showmo_prj007_t32nq_gc8602_aic8800d80/overlay/var/www/a/showmo.js
@@ -0,0 +1,65 @@
+// Shared helpers for the Showmo web UI pages.
+const CGI = "/x/showmo.cgi";
+
+function b64(s) {
+	return btoa(unescape(encodeURIComponent(s)));
+}
+
+function toast(msg, ok = true) {
+	const t = document.getElementById("toast");
+	t.textContent = msg;
+	t.className = ok ? "ok" : "err";
+	t.style.display = "block";
+	clearTimeout(toast.timer);
+	toast.timer = setTimeout(() => (t.style.display = "none"), ok ? 5000 : 9000);
+}
+
+async function getJSON(action) {
+	const r = await fetch(`${CGI}?a=${action}`, { cache: "no-store" });
+	if (r.status === 401) location.href = "login.html";
+	return r.json();
+}
+
+// POST one "key=<base64>" line per field; resolves to the JSON reply.
+async function post(action, fields = {}) {
+	const body = Object.entries(fields).map(([k, v]) => `${k}=${b64(String(v))}`).join("\n");
+	const r = await fetch(`${CGI}?a=${action}`, {
+		method: "POST",
+		headers: { "Content-Type": "text/plain" },
+		body,
+	});
+	if (r.status === 401) location.href = "login.html";
+	const j = await r.json().catch(() => ({ ok: false, error: `HTTP ${r.status}` }));
+	toast(j.ok ? j.message || "OK" : j.error || "Erreur", j.ok);
+	return j;
+}
+
+// Runs fn with the button disabled, for buttons that trigger slow actions.
+async function busy(btn, fn) {
+	btn.disabled = true;
+	try {
+		return await fn();
+	} finally {
+		btn.disabled = false;
+	}
+}
+
+async function requireLogin() {
+	const s = await fetch("/x/session-status.cgi", { cache: "no-store" }).then((r) => r.json()).catch(() => ({}));
+	if (!s.authenticated) location.href = "login.html";
+	return s;
+}
+
+function rtspUrl(st, withPass = false) {
+	const user = st.rtsp.user || "";
+	const pass = withPass ? ":<mot de passe>" : "";
+	const port = st.rtsp.port && st.rtsp.port !== "554" ? `:${st.rtsp.port}` : ":554";
+	return `rtsp://${user}${pass}@${st.device.ip}${port}/${st.rtsp.endpoint || "ch0"}`;
+}
+
+function uptime(s) {
+	const d = Math.floor(s / 86400);
+	const h = Math.floor((s % 86400) / 3600);
+	const m = Math.floor((s % 3600) / 60);
+	return (d ? `${d} j ` : "") + `${h} h ${m} min`;
+}
diff --git a/configs/cameras-exp/showmo_prj007_t32nq_gc8602_aic8800d80/overlay/var/www/config.html b/configs/cameras-exp/showmo_prj007_t32nq_gc8602_aic8800d80/overlay/var/www/config.html
