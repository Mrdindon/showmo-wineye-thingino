+<!doctype html>
+<html lang="fr">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1">
+<title>Config — caméra</title>
+<link rel="stylesheet" href="/a/showmo.css">
+</head>
+<body>
+<div id="defpw" class="banner">Mot de passe root par défaut : changez-le ci-dessous (section Compte root).</div>
+<header>
+	<strong id="name">Caméra</strong>
+	<a href="index.html">Direct</a>
+	<a href="config.html" class="on">Config</a>
+	<a href="/x/logout.cgi">Déconnexion</a>
+</header>
+<main class="grid">
+	<div class="card">
+		<h2>État</h2>
+		<table id="state"></table>
+		<div class="row"><button id="reboot" class="danger">Redémarrer</button></div>
+	</div>
+
+	<div class="card">
+		<h2>Flux RTSP</h2>
+		<p class="hint" id="res"></p>
+		<label for="fps">Images par seconde</label>
+		<select id="fps"><option>25</option><option>20</option><option>15</option></select>
+		<label for="mbps">Débit (Mb/s, CBR)</label>
+		<input id="mbps" type="number" min="2" max="20" step="1">
+		<p class="hint">Le capteur tourne à 25 i/s : 20 ou 15 i/s donnent un rythme irrégulier. Valeurs de base : 25 i/s, 15 Mb/s.</p>
+		<div class="row">
+			<button id="stream">Appliquer</button>
+			<button id="streamdef" class="alt">Défaut (25 i/s · 15 Mb/s)</button>
+		</div>
+	</div>
+
+	<div class="card">
+		<h2>Horodatage</h2>
+		<label><input id="osdvis" type="checkbox">Afficher la date et l'heure (en haut à gauche)</label>
+		<label for="osdsize">Taille (pixels, en 2560×1440)</label>
+		<select id="osdsize"></select>
+		<label for="tz">Fuseau horaire</label>
+		<select id="tz"></select>
+		<p class="hint">Appliquer redémarre la vidéo (environ 20 s).</p>
+		<div class="row"><button id="osd">Appliquer</button></div>
+	</div>
+
+	<div class="card">
+		<h2>Identifiants RTSP</h2>
+		<label for="ruser">Utilisateur</label>
+		<input id="ruser" autocomplete="off">
+		<label for="rpass">Nouveau mot de passe</label>
+		<input id="rpass" type="password" autocomplete="new-password">
+		<p class="hint">À reporter dans Blue Iris. Sans espace ni « # ».</p>
+		<div class="row"><button id="rtsp">Enregistrer</button></div>
+	</div>
+
+	<div class="card">
+		<h2>Réseau</h2>
+		<label for="host">Nom de la caméra (réseau, DHCP)</label>
+		<input id="host" autocomplete="off">
+		<div class="row"><button id="hostbtn" class="alt">Renommer</button></div>
+		<label for="ssid">WiFi (SSID)</label>
+		<input id="ssid" autocomplete="off">
+		<label for="wpass">Mot de passe</label>
+		<input id="wpass" type="password" autocomplete="new-password">
+		<p class="hint">Pris en compte au redémarrage. Une erreur rend la caméra injoignable : bouton reset 5 s pour revenir en mode configuration.</p>
+		<div class="row"><button id="wifi">Enregistrer le WiFi</button></div>
+	</div>
+
+	<div class="card">
+		<h2>Compte root (web, SSH, console)</h2>
+		<label for="pw1">Nouveau mot de passe</label>
+		<input id="pw1" type="password" autocomplete="new-password">
+		<label for="pw2">Confirmer</label>
+		<input id="pw2" type="password" autocomplete="new-password">
+		<div class="row"><button id="pw">Changer</button></div>
+		<label for="keys">Clés SSH autorisées (une par ligne)</label>
+		<textarea id="keys" placeholder="ssh-ed25519 AAAA… utilisateur@poste"></textarea>
+		<p class="hint" id="keyinfo"></p>
+		<div class="row"><button id="sshkey" class="alt">Remplacer les clés</button></div>
+	</div>
+
+	<div class="card">
+		<h2>Mise à jour du firmware</h2>
+		<p class="hint">Image complète thingino Showmo (16 Mo). Seuls le noyau et le système sont réécrits : u-boot et configuration conservés. Ne pas couper l'alimentation pendant l'écriture.</p>
+		<input id="fw" type="file" accept=".bin">
+		<progress id="fwprog" value="0" max="100" hidden></progress>
+		<p class="hint" id="fwinfo"></p>
+		<div class="row"><button id="fwgo">Envoyer et vérifier</button><button id="fwapply" class="danger" hidden>Installer</button></div>
+	</div>
+</main>
+<div id="toast"></div>
+<script src="/a/showmo.js"></script>
+<script>
+const $ = (id) => document.getElementById(id);
+
+async function load() {
+	const st = await getJSON("status");
+	const d = st.device;
+	$("name").textContent = d.hostname;
+	$("defpw").style.display = st.default_password ? "block" : "none";
+	const [used, total] = (d.emmc || "0 0").split(" ").map(Number);
+	const rows = [
+		["Adresse IP", d.ip],
+		["MAC", d.mac],
+		["WiFi", `${d.ssid} (${d.signal} dBm)`],
+		["En marche depuis", uptime(d.uptime)],
+		["Température SoC", d.temp ? `${Number(d.temp).toFixed(1)} °C` : "—"],
+		["eMMC", total ? `${(used / 1048576).toFixed(1)} / ${(total / 1048576).toFixed(1)} Go` : "non montée"],
+		["Firmware", d.build],
+		["URL RTSP", rtspUrl(st, true)],
+	];
+	$("state").innerHTML = "";
+	for (const [k, v] of rows) {
+		const tr = $("state").insertRow();
+		tr.insertCell().textContent = k;
+		tr.insertCell().textContent = v || "—";
+	}
+	$("res").textContent = `${st.stream.width}×${st.stream.height}, actuellement ${st.stream.fps} i/s, ${st.stream.bitrate / 1e6} Mb/s ${st.stream.rc_mode.toUpperCase()}`;
+	$("fps").value = st.stream.fps;
+	$("mbps").value = Math.round(st.stream.bitrate / 1e6);
+	$("osdvis").checked = st.osd.visible === "true";
+	$("osdsize").innerHTML = st.osd.sizes.split(" ").map((s) => `<option>${s}</option>`).join("");
+	$("osdsize").value = st.osd.size || "64";
+	$("ruser").value = st.rtsp.user;
+	$("ssid").value = d.ssid;
+	$("host").value = d.hostname;
+	$("keyinfo").textContent = `${st.ssh_keys} clé(s) enregistrée(s).`;
+	const tz = await getJSON("tzlist");
+	$("tz").innerHTML = tz.map((z) => `<option>${z.n}</option>`).join("");
+	$("tz").value = st.tz;
+}
+
+$("stream").onclick = (e) => busy(e.target, () => post("stream", { fps: $("fps").value, mbps: $("mbps").value }).then(load));
+$("streamdef").onclick = (e) => busy(e.target, () => post("stream-default").then(load));
+
+$("osd").onclick = (e) => busy(e.target, async () => {
+	const tzNow = (await getJSON("status")).tz;
+	if ($("tz").value !== tzNow) await post("tz", { tz: $("tz").value });
+	await post("osd", { visible: $("osdvis").checked ? "true" : "false", size: $("osdsize").value });
+});
+
+$("rtsp").onclick = (e) => busy(e.target, async () => {
+	if (!$("rpass").value) return toast("Entrez le nouveau mot de passe RTSP", false);
+	const j = await post("rtsp", { user: $("ruser").value, pass: $("rpass").value });
+	if (j.ok) { $("rpass").value = ""; load(); }
+});
+
+$("hostbtn").onclick = (e) => busy(e.target, () => post("hostname", { name: $("host").value }).then(load));
+
+$("wifi").onclick = (e) => busy(e.target, async () => {
+	if (!confirm(`Enregistrer le réseau « ${$("ssid").value} » ? Il sera utilisé au prochain redémarrage.`)) return;
+	const j = await post("wifi", { ssid: $("ssid").value, pass: $("wpass").value });
+	if (j.ok) $("wpass").value = "";
+});
+
+$("pw").onclick = (e) => busy(e.target, async () => {
+	if ($("pw1").value !== $("pw2").value) return toast("Les deux mots de passe diffèrent", false);
+	const j = await post("password", { pw: $("pw1").value });
+	if (j.ok) { $("pw1").value = $("pw2").value = ""; $("defpw").style.display = "none"; }
+});
+
+$("sshkey").onclick = (e) => busy(e.target, () => post("sshkey", { key: $("keys").value }).then(load));
+
+$("reboot").onclick = (e) => {
+	if (confirm("Redémarrer la caméra ? Le flux sera coupé environ 40 s.")) busy(e.target, () => post("reboot"));
+};
+
+$("fwgo").onclick = (e) => {
+	const f = $("fw").files[0];
+	if (!f) return toast("Choisissez un fichier .bin", false);
+	if (f.size !== 16777216) return toast("Il faut l'image complète de 16 Mo", false);
+	e.target.disabled = true;
+	const x = new XMLHttpRequest();
+	x.open("POST", `${CGI}?a=upload`);
+	x.setRequestHeader("Content-Type", "application/octet-stream");
+	$("fwprog").hidden = false;
+	x.upload.onprogress = (p) => ($("fwprog").value = (100 * p.loaded) / p.total);
+	x.onload = async () => {
+		e.target.disabled = false;
+		const up = JSON.parse(x.responseText || "{}");
+		if (!up.ok) return toast(up.error || "Envoi échoué", false);
+		const c = await post("upgrade-check");
+		if (!c.ok) return;
+		$("fwinfo").textContent = `Image valide (md5 ${c.md5}) : noyau ${c.kernel} o, système ${c.rootfs} o.`;
+		$("fwapply").hidden = false;
+	};
+	x.onerror = () => { e.target.disabled = false; toast("Envoi échoué", false); };
+	x.send(f);
+};
+
+$("fwapply").onclick = async (e) => {
+	if (!confirm("Installer cette image ? La caméra redémarrera. Ne pas couper l'alimentation.")) return;
+	e.target.disabled = $("fwgo").disabled = true;
+	const j = await post("upgrade-apply");
+	if (!j.ok) return;
+	const poll = setInterval(async () => {
+		const l = await getJSON("upgrade-log").catch(() => null);
+		if (!l) return;
+		$("fwinfo").textContent = l.log.split("|").filter(Boolean).pop() || "";
+		if (/FAIL/.test(l.log)) { clearInterval(poll); toast("Échec : " + l.log, false); }
+		if (/DONE/.test(l.log)) {
+			clearInterval(poll);
+			$("fwinfo").textContent = "Écrit et vérifié. Redémarrage… la page se rechargera.";
+			setTimeout(() => location.reload(), 60000);
+		}
+	}, 2000);
+};
+
+requireLogin().then(load);
+</script>
+</body>
+</html>
